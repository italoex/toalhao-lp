# Temporários do processamento de mídia
images/.tmp-conversao.*

# Observação: a pasta midias/ É versionada de propósito.
# É ela que permite subir os originais pelo site do GitHub e deixar o
# GitHub Actions gerar sozinho os arquivos otimizados em images/.
# Limite do upload pelo navegador: 25 MB por arquivo.

# Artefatos do Python
__pycache__/
*.pyc

# Masters de vídeo: pesados demais para o histórico do Git.
# midias/hero.mp4 tem 53 MB; entrar no histórico é praticamente
# irreversível (exige reescrever o histórico para remover depois).
# O master está no Google Drive; o que o site usa é images/hero-video.mp4,
# gerado a partir dele. Para versionar mesmo assim, remova a linha abaixo.
midias/*.mp4
midias/*.mov
midias/*.mkv
